# Copy this file to .env and edit the copy. Never commit .env.
# Restart the server after changing anything here.

# Any OpenAI-compatible endpoint.
#   OpenRouter (paid):        https://openrouter.ai/api/v1
#   Ollama (free, on this PC): http://localhost:11434/v1  -> also set LLM_API_KEY=ollama
#                                                           and LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M (an instruct model, D-39)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Leave empty to use mock mode (no internet or key needed).
# Ollama ignores the key, but it must not be empty (empty = mock mode), so use: ollama
LLM_API_KEY=

# Model used for replies. (The spec's qwen/qwen3-8b is no longer on OpenRouter.)
LLM_MODEL=qwen/qwen3-14b

# Model used for strategy classification. Empty = same as LLM_MODEL.
CLASSIFIER_MODEL=

# true forces mock mode even when an API key is set.
MOCK_MODE=false

# strategies_4 (default) or strategies_esconv8 (files in backend/data/).
STRATEGY_SET=strategies_4

# Add today's mood and the PHQ-9 severity band to the prompt.
INCLUDE_CHECKINS_IN_PROMPT=true

# Number of previous messages sent to the model (1 message = 1 turn).
HISTORY_TURNS=6

# Timezone used to decide what "today" means for daily check-ins.
APP_TIMEZONE=Asia/Kolkata

# Shows preview-day buttons and demo labels.
DEMO_MODE=true

# Optional name/email of the adult who follows up on safety flags.
FOLLOWUP_CONTACT=

# Seconds to wait for one model reply. Local models on a CPU can be slow.
LLM_TIMEOUT_SECONDS=120

# SQLite file location, relative to the project folder.
DB_PATH=data/stillspace.db

# ---------- Online version (Phase 11, see docs/DEPLOYMENT.md) ----------
# local (default) or production. production = only issued codes, consent text +
# age question, demo and /docs pages off, FOLLOWUP_CONTACT required.
APP_ENV=local

# Empty = SQLite file (DB_PATH). Set = Postgres, e.g. Supabase:
# Project -> Connect -> Session pooler -> URI (contains the password: never commit it).
DATABASE_URL=

# Limits (0 = no limit). The safety reply is never limited.
CHAT_LIMIT_PER_HOUR=40
DAILY_CHAT_LIMIT=700
LOGIN_LIMIT_PER_MINUTE=10

# 18plus_or_guardian (18+ and under-18 with guardian consent) or 18plus_only.
AGE_POLICY=18plus_or_guardian
