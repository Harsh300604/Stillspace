# Copy this file to .env and edit the copy. Never commit .env.
# Restart the server after changing anything here.

# Any OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Leave empty to use mock mode (no internet or key needed).
LLM_API_KEY=

# Model used for replies.
LLM_MODEL=qwen/qwen3-8b

# Model used for strategy classification. Empty = same as LLM_MODEL.
CLASSIFIER_MODEL=

# true forces mock mode even when an API key is set.
MOCK_MODE=false

# strategies_4 (default) or strategies_esconv8 (files in backend/data/).
STRATEGY_SET=strategies_4

# Add today's mood and the PHQ-9 severity band to the prompt.
INCLUDE_CHECKINS_IN_PROMPT=true

# Number of previous messages sent to the model (1 message = 1 turn).
HISTORY_TURNS=6

# Timezone used to decide what "today" means for daily check-ins.
APP_TIMEZONE=Asia/Kolkata

# Shows preview-day buttons and demo labels.
DEMO_MODE=true

# Optional name/email of the adult who follows up on safety flags.
FOLLOWUP_CONTACT=

# SQLite file location, relative to the project folder.
DB_PATH=data/stillspace.db
