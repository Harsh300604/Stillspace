  "patterns": [
    {"id": "en-kill-myself", "regex": "\\bkill(ing)? ?my ?self\\b"},
    {"id": "en-hurt-myself", "regex": "\\b(hurt|hurting|harm|harming|cut|cutting) ?my ?self\\b"},
    {"id": "en-self-harm", "regex": "\\bself[ -]?harm(ing)?\\b"},
    {"id": "en-dont-want-live", "regex": "\\b(don'?t|do not|dont) want to (live|be alive|exist)\\b"},
    {"id": "en-end-it", "regex": "\\bend(ing)? it (all|tonight|forever)\\b"},
    {"id": "en-take-pills", "regex": "\\b(take|took|taking|swallow|swallowed) (all|a lot of|lots of|too many) (of )?(my |the )?(pills|tablets|meds|medicine)\\b"},
    {"id": "en-jump-off", "regex": "\\bjump(ing)? (off|from) (a |the |my )?(bridge|building|roof|terrace|balcony)\\b"},
    {"id": "en-not-safe", "regex": "\\b(i am|i'm|im) not safe\\b"},
    {"id": "en-someone-hurting-me", "regex": "\\bsomeone (is )?(hurting|hitting|abusing) me\\b"},
    {"id": "hi-mar-jaana", "regex": "\\bmar ?ja+(na|un|unga|ungi|oon|oonga|oongi)\\b"},
    {"id": "hi-marna-chahta", "regex": "\\bmarna chaht(a|i)\\b"},
    {"id": "hi-jeena-nahi", "regex": "\\bj(ee|i)na nahi chaht(a|i)\\b"},
    {"id": "hi-jine-ka-mann", "regex": "\\bj(ee|i)ne ka (mann|man|mood) nahi\\b"}
  ]
